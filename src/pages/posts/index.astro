---
import { getCollection } from 'astro:content';
import ThemeInit from '../../components/ThemeInit.astro';
import BusuanziScript from '../../components/BusuanziScript.astro';
import SiteStats from '../../components/SiteStats.astro';
import GuestbookPanel from '../../components/GuestbookPanel.astro';
import { getPostUrl } from '../../utils/permalink';

// 取所有文章按 date 降序（与 Jekyll site.posts 一致）
const allPosts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// 按年份分组（年份降序）
const postsByYear = new Map<string, typeof allPosts>();
for (const post of allPosts) {
  const year = String(new Date(post.data.date).getFullYear());
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const yearGroups = Array.from(postsByYear.entries()).map(([year, posts]) => ({ year, posts }));

// 工具函数
function formatDate(d: Date): string {
  const date = new Date(d);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function categoriesArr(c: unknown): string[] {
  if (!c) return [];
  if (Array.isArray(c)) return c;
  return [String(c)];
}

// 分类判定：复刻原 Jekyll capture post_groups 逻辑
function computeCategories(post: { data: { categories?: unknown; tags?: string[]; title: string } }): string {
  const cats = categoriesArr(post.data.categories);
  const tags = post.data.tags ?? [];
  const title = post.data.title;
  const groups = ['notes'];
  if (cats.includes('技术折腾') || tags.includes('LLM') || tags.includes('Agent') || tags.includes('Python') || title.includes('Git') || title.includes('CLI')) {
    groups.push('tech');
  }
  if (tags.includes('学术写作') || title.includes('Academic Writing') || title.includes('Markdown')) {
    groups.push('writing');
  }
  if (tags.includes('效率') || tags.includes('Windows') || title.includes('压缩') || title.includes('妙控板') || title.includes('快捷键') || title.includes('整理电脑')) {
    groups.push('tools');
  }
  return groups.join(' ');
}

// data-search：复刻原 Jekyll 逻辑
function computeSearch(post: { data: { title: string; tags?: string[]; categories?: unknown } }): string {
  const title = post.data.title.toLowerCase();
  const tags = (post.data.tags ?? []).join(' ').toLowerCase();
  const cats = categoriesArr(post.data.categories).join(' ').toLowerCase();
  // escape HTML 特殊字符（Jekyll escape 过滤器）
  const escaped = (title + ' ' + tags + ' ' + cats).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  return escaped;
}

// post-tags 显示：复刻原逻辑
function computeTagsDisplay(post: { data: { categories?: unknown; tags?: string[] } }): string {
  const cats = categoriesArr(post.data.categories);
  const tags = post.data.tags ?? [];
  let result = '';
  if (cats.length > 0) result += cats.join(' · ');
  if (cats.length > 0 && tags.length > 0) result += ' · ';
  if (tags.length > 0) {
    result += tags.slice(0, 3).join(' · ');
  } else {
    result += '知识笔记';
  }
  return result;
}

const totalPosts = allPosts.length;

// 全局编号计数器：跨年份递增（不每年重置）
let archiveIndex = 0;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>文章归档 · The Time Forever</title>
  <ThemeInit />
  <link rel="stylesheet" href="/assets/css/site-tokens.css?v=20260723-refactor">
  <link rel="stylesheet" href="/assets/css/posts-archive.css?v=20260723-refactor">
  <link rel="stylesheet" href="/assets/css/guestbook.css?v=20260724-shared">
</head>
<body>
  <canvas class="particle-field" id="particle-field" aria-hidden="true"></canvas>

  <div class="site-shell">
    <header class="topbar">
      <a class="brand" href="/">The Time Forever</a>
      <div class="topbar-actions">
        <nav class="nav" aria-label="主要导航">
          <a href="/">首页</a>
          <a href="/posts/" aria-current="page">文章</a>
          <a href="#guestbook-panel" data-open-guestbook aria-controls="guestbook-panel" aria-expanded="false">留言</a>
          <a href="https://github.com/The-time-forever">GitHub</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="切换深浅色模式" title="切换深浅色模式">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
          </svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20.3 15.2A8.5 8.5 0 0 1 8.8 3.7 8.5 8.5 0 1 0 20.3 15.2Z"></path>
          </svg>
        </button>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="archive-title">
        <div class="hero-copy">
          <h1 id="archive-title">文章<span>ARCHIVE</span></h1>
          <p class="hero-description">记录技术探索、工具实践与思考沉淀，按时间顺序归档仓库中的所有文章。</p>
        </div>
      </section>

      <section aria-label="文章检索与筛选">
        <div class="archive-tools">
          <label class="search" for="post-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-4-4"></path>
            </svg>
            <input id="post-search" type="search" autocomplete="off" placeholder="搜索文章标题、关键词…" aria-label="搜索文章">
          </label>
          <div class="filters" aria-label="文章分类">
            <button class="filter" type="button" data-filter="all" aria-pressed="true">全部</button>
            <button class="filter" type="button" data-filter="tech" aria-pressed="false">技术折腾</button>
            <button class="filter" type="button" data-filter="writing" aria-pressed="false">学术写作</button>
            <button class="filter" type="button" data-filter="tools" aria-pressed="false">工具效率</button>
            <button class="filter" type="button" data-filter="notes" aria-pressed="false">知识笔记</button>
          </div>
        </div>

        <div class="archive">
          {yearGroups.map((group) => (
            <section class="year-group" aria-labelledby={`year-${group.year}`}>
              <h2 class="year" id={`year-${group.year}`}>{group.year}</h2>
              <ol class="post-list">
                {group.posts.map((post) => {
                  archiveIndex += 1;
                  const paddedIndex = String(archiveIndex).padStart(2, '0').slice(-2);
                  const dataCategory = computeCategories(post);
                  const dataSearch = computeSearch(post);
                  const tagsDisplay = computeTagsDisplay(post);
                  const url = post.data.redirect_to ?? getPostUrl(post);
                  const isExternal = !!post.data.redirect_to;
                  return (
                    <li class="post-item" data-category={dataCategory} data-search={dataSearch}>
                      <span class="post-number">{paddedIndex}</span>
                      {isExternal ? (
                        <a class="post-link" href={url} target="_blank" rel="noopener noreferrer">{post.data.title}</a>
                      ) : (
                        <a class="post-link" href={url}>{post.data.title}</a>
                      )}
                      <time class="post-date" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
                      <span class="post-tags">{tagsDisplay}</span>
                    </li>
                  );
                })}
              </ol>
            </section>
          ))}
          <p class="empty-state" id="empty-state">没有找到匹配的文章。</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="stat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 20v-8h4v8M10 20V5h4v15M16 20v-5h4v5M2 20h20"></path>
        </svg>
        <span><small class="stat-label">文章总数</small><strong class="stat-value">{totalPosts}</strong></span>
      </div>
      <SiteStats variant="archive" />
      <p class="copyright">© 2026 The Time Forever<br>持续记录，持续构建。</p>
    </footer>
  </div>

  <GuestbookPanel />

  <script src="/assets/js/theme-toggle.js?v=20260723-refactor" defer></script>
  <script src="/assets/js/particle-field.js?v=20260723-refactor" defer></script>
  <script src="/assets/js/posts-archive.js?v=20260723-refactor" defer></script>
  <script src="/assets/js/guestbook.js?v=20260724-shared" defer></script>
  <BusuanziScript />
</body>
</html>
