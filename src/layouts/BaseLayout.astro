---
import ThemeInit from '../components/ThemeInit.astro';

interface Props {
  title: string;
  lang?: string;
}

const { title, lang = 'zh-CN' } = Astro.props;
---
<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ThemeInit />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
